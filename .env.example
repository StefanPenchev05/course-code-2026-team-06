# Local development only
POSTGRES_DB=tutti
POSTGRES_USER=tutti
POSTGRES_PASSWORD=tutti_dev
POSTGRES_PORT=5432

# Go API variables. Export these into the shell that runs the API.
DATABASE_URL=postgres://tutti:tutti_dev@localhost:5432/tutti?sslmode=disable
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
HTTP_ADDR=127.0.0.1:8080
PUBLIC_ORIGIN=http://localhost:8080
UNIVERSITY_EMAIL_DOMAINS=
SESSION_TTL=8h
ACTIVATION_TTL=24h
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_THREADS=2
ARGON2_CONCURRENCY=2

# Background worker. Set SMTP_HOST and SMTP_FROM before starting it.
# Compose uses the service hostname "postgres"; go run uses DATABASE_URL above.
WORKER_DATABASE_URL=postgres://tutti:tutti_dev@postgres:5432/tutti?sslmode=disable
WORKER_EXPIRATION_INTERVAL=10s
WORKER_EXPIRATION_BATCH_SIZE=50
WORKER_EMAIL_INTERVAL=5s
WORKER_EMAIL_BATCH_SIZE=20
WORKER_EMAIL_MAX_ATTEMPTS=5
WORKER_EMAIL_LEASE=90s
WORKER_EMAIL_RETRY_BASE=30s
WORKER_EMAIL_RETRY_MAX=30m
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS_MODE=starttls
SMTP_CONNECT_TIMEOUT=5s
SMTP_SEND_TIMEOUT=20s
