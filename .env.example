# Local development only
POSTGRES_DB=tutti
POSTGRES_USER=tutti
POSTGRES_PASSWORD=tutti_dev
POSTGRES_PORT=5432

# Go API variables. Export these into the shell that runs the API.
DATABASE_URL=postgres://tutti:tutti_dev@localhost:5432/tutti?sslmode=disable
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
HTTP_ADDR=127.0.0.1:8080
PUBLIC_ORIGIN=http://localhost:8080
# Required deployment ID: all API replicas sharing one outbox must agree.
# Use distinct values AND isolated Identity session storage across deployments.
REALTIME_NAMESPACE=tutti-dev
# Optional operational JSON metrics, readiness and liveness; loopback only.
REALTIME_MONITOR_ADDR=127.0.0.1:9091
UNIVERSITY_EMAIL_DOMAINS=
SESSION_TTL=8h
ACTIVATION_TTL=24h
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_THREADS=2
ARGON2_CONCURRENCY=2

# Background worker. Set SMTP_HOST and SMTP_FROM before starting it.
# Compose uses the service hostname "postgres"; go run uses DATABASE_URL above.
WORKER_DATABASE_URL=postgres://tutti:tutti_dev@postgres:5432/tutti?sslmode=disable
WORKER_EXPIRATION_INTERVAL=10s
WORKER_EXPIRATION_BATCH_SIZE=50
WORKER_EMAIL_INTERVAL=5s
WORKER_EMAIL_BATCH_SIZE=20
WORKER_EMAIL_MAX_ATTEMPTS=5
WORKER_EMAIL_LEASE=90s
WORKER_EMAIL_RETRY_BASE=30s
WORKER_EMAIL_RETRY_MAX=30m
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional runtime-mounted secret; do not set together with SMTP_PASSWORD.
SMTP_PASSWORD_FILE=
SMTP_TLS_MODE=starttls
# Optional runtime-mounted additional CA bundle. Hostname verification stays on.
SMTP_CA_FILE=
SMTP_CONNECT_TIMEOUT=5s
SMTP_SEND_TIMEOUT=20s

# Optional local Keycloak demo (compose.sso.yaml), never real Uni.lu credentials.
# Generate distinct random passwords/secrets locally; empty values fail closed.
# These names configure Keycloak only; Go uses OIDC_CLIENT_SECRET below.
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=
TUTTI_OIDC_CLIENT_SECRET=

# Optional Go OIDC authentication for prelinked Tutti accounts (Redis sessions).
# Export these to the API shell; .env.sso configures Keycloak separately.
OIDC_ENABLED=false
OIDC_ISSUER_URL=http://localhost:8180/realms/tutti-demo
OIDC_CLIENT_ID=tutti-backend
OIDC_REDIRECT_URL=http://localhost:8080/api/v1/auth/oidc/callback
OIDC_TRANSACTION_TTL=5m
OIDC_HTTP_TIMEOUT=3s
# Fixed same-origin path after login; serve the frontend at PUBLIC_ORIGIN.
OIDC_POST_LOGIN_PATH=/

# Required when OIDC_ENABLED=true. Privately set equal to TUTTI_OIDC_CLIENT_SECRET.
OIDC_CLIENT_SECRET=
